  "tips_category_story": "Priča",
  "tips_letter_1_subtitle": "Budite jasni u vezi s razlogom pisanja kako bi poruka ostala usmjerena i lako razumljiva primatelju.",
  "tips_letter_1_title": "Znajte svoju svrhu",
  "tips_letter_2_subtitle": "Prilagodite svoj jezik, razinu formalnosti, emocionalni ton i detalje na temelju vašeg odnosa s čitateljem.",
  "tips_letter_2_title": "Razmislite o primatelju",
  "tips_letter_3_subtitle": "Odaberite pozdrav koji odgovara vašem odnosu s primateljem i odmah uspostavlja pravi ton.",
  "tips_letter_3_title": "Započnite na odgovarajući način",
  "tips_letter_4_subtitle": "Logično organizirajte glavne točke i izbjegavajte nepotrebne detalje koji odvlače pažnju od svrhe pisma.",
  "tips_letter_4_title": "Neka poruka bude jasna",
  "tips_letter_5_subtitle": "Kada je prikladno, uključite iskrene detalje, osjećaje ili specifična sjećanja koja pismo čine autentičnim.",
  "tips_letter_5_title": "Dodajte osobni pečat",
  "tips_letter_6_subtitle": "Završite završetkom koji odgovara tonu i ostavlja primatelju jasan konačni dojam.",
  "tips_letter_6_title": "Završite prikladno",
  "tips_letter_reminder": "Najbolja pisma djeluju namjerno. Pišite za osobu koja prima poruku i odaberite ton na temelju vašeg odnosa.",
  "tips_letter_subtitle": "Pišite jasna i promišljena pisma prilagođavajući ton, strukturu i poruku primatelju i svrsi.",
  "tips_letter_title": "Savjeti za pisma",
  "tips_lyrics_1_subtitle": "Odlučite o čemu je vaša pjesma zapravo i neka stihovi, udice i emocionalni trenuci budu povezani s tom središnjom idejom.",
  "tips_lyrics_1_title": "Poznajte glavnu temu",
  "tips_lyrics_2_subtitle": "Stvorite nezaboravnu frazu ili refren koji obuhvaća središnju emociju i ostaje lako pamtljiv slušateljima.",
  "tips_lyrics_2_title": "Napišite snažnu udicu",
  "tips_lyrics_3_subtitle": "Koristite prirodne riječi, prihvatljive duljine stihova i fraze koje se osjećaju ugodno kada se izgovore ili pjevaju naglas.",
  "tips_lyrics_3_title": "Neka tekst bude pjevljiv",
  "tips_lyrics_4_subtitle": "Ponovite važne fraze dovoljno puta da budu nezaboravne, a da se cijela pjesma ne čini repetitivnom.",
  "tips_lyrics_4_title": "Mudro koristite ponavljanje",
  "tips_lyrics_5_subtitle": "Odaberite riječi i slike koje odgovaraju žanru, tempu, emocionalnom tonu i atmosferi pjesme.",
  "tips_lyrics_5_title": "Uskladite raspoloženje",
  "tips_lyrics_6_subtitle": "Koristite emocije i iskustva koja slušatelji mogu prepoznati, a istovremeno dajte svojim tekstovima jedinstvenu osobnost.",
  "tips_lyrics_6_title": "Neka bude bliska",
  "tips_lyrics_reminder": "Pročitajte tekst pjesme naglas ili ga zamislite s melodijom. Riječi ne bi trebale samo dobro izgledati na papiru - trebale bi se osjećati prirodno kada se pjevaju.",
  "tips_lyrics_subtitle": "Stvorite nezaboravne tekstove kombinirajući emocije, ritam, ponavljanje, snažne slike i jasan glazbeni identitet.",
  "tips_lyrics_title": "Savjeti za tekstove pjesama",
  "tips_poem_1_subtitle": "Odlučite koji osjećaj, iskustvo, sjećanje ili ideju pjesma treba izraziti prije nego što oko nje izgradite svoj jezik.",
  "tips_poem_1_title": "Odaberite središnju emociju",
  "tips_poem_2_subtitle": "Koristite senzorne detalje i vizualni jezik kako biste pomogli čitateljima da vide, čuju, osjete i zamisle ono što opisujete.",
  "tips_poem_2_title": "Koristite živopisne slike",
  "tips_poem_3_subtitle": "Uklonite nepotrebne riječi i usredotočite se na jezik koji stvara najjaču sliku, emociju, ritam ili značenje.",
  "tips_poem_3_title": "Pažljivo birajte riječi",
  "tips_poem_4_subtitle": "Koristite duljinu retka, ponavljanje, rimu, metar ili slobodni stih kako biste stvorili tijek koji odgovara emociji pjesme.",
  "tips_poem_4_title": "Eksperimentirajte s ritmom",
  "tips_poem_5_subtitle": "Metafore, usporedbe, simbolika i personifikacija mogu transformirati jednostavne ideje u bogatija emocionalna iskustva.",
  "tips_poem_5_title": "Koristite figurativni jezik",
  "tips_poem_6_subtitle": "Završite slikom, spoznajom, emocionalnim pomakom ili promišljenim stihom koji ostaje u pamćenju čitatelja.",
  "tips_poem_6_title": "Stvorite smislen završetak",
  "tips_poem_reminder": "Poeziji nije potrebno mnogo riječi da bi se osjećala snažno. Snažne slike, ritam i istinske emocije često su važnije od složenosti.",
  "tips_poem_subtitle": "Koristite emocije, slike, ritam i pažljivo odabrane riječi kako biste stvorili poeziju koja se čini ekspresivnom, osobnom i nezaboravnom.",
  "tips_poem_title": "Savjeti za pjesme",
  "tips_remember": "Zapamti",
  "tips_screenplay_1_subtitle": "Opišite radnje i detalje koje gledatelji zapravo mogu vidjeti ili čuti umjesto da objašnjavaju nevidljive unutarnje misli.",
  "tips_screenplay_1_title": "Razmišljajte vizualno",
  "tips_screenplay_2_subtitle": "Svaka scena treba razvijati likove, otkrivati ​​informacije, stvarati sukob, mijenjati odnose ili pomicati radnju naprijed.",
  "tips_screenplay_2_title": "Dajte svakoj sceni svrhu",
  "tips_screenplay_3_subtitle": "Pišite radnju u sažetim, čitljivim odlomcima i uključite samo detalje koji su važni za razumijevanje scene.",
  "tips_screenplay_3_title": "Neka radnja bude jasna",
  "tips_screenplay_4_subtitle": "Dajte likovima različite glasove i izbjegavajte dijalog koji postoji samo kako bi se informacije izravno objasnile publici.",
  "tips_screenplay_4_title": "Pišite prirodni dijalog.",
  "tips_screenplay_5_subtitle": "Započnite scene blizu važnog dramskog trenutka i završite kada je glavna svrha scene završena.",
  "tips_screenplay_5_title": "Uđite kasno, odite rano.",
  "tips_screenplay_6_subtitle": "Koristite radnje, reakcije, tišinu, okruženje i izbore likova kako biste napetost učinili vidljivom na ekranu.",
  "tips_screenplay_6_title": "Stvorite vizualni sukob.",
  "tips_screenplay_reminder": "Scenarij je namijenjen da se vidi i čuje. Neka opisi budu vizualni, dijalozi svrhoviti, a svaka scena lako zamisliva.",
  "tips_screenplay_subtitle": "Pišite vizualno, neka scene budu svrhovite i koristite konciznu radnju i dijalog kako biste stvorili scenarij koji se čini filmskim.",
  "tips_screenplay_title": "Savjeti za scenarij",
  "tips_speech_1_subtitle": "Razmislite tko će slušati i prilagodite svoje primjere, jezik, humor, ton i formalnost kako bi odgovarali toj publici.",
  "tips_speech_1_title": "Poznajte svoju publiku",
  "tips_speech_2_subtitle": "Započnite s pitanjem, kratkom pričom, iznenađujućom idejom ili pamtljivom izjavom koja odmah privlači pažnju.",
  "tips_speech_2_title": "Otvoreno s utjecajem",
  "tips_speech_3_subtitle": "Neka središnja ideja bude jasna tijekom cijelog govora kako bi slušatelji zapamtili što je najvažnije nakon što završi.",
  "tips_speech_3_title": "Usredotočite se na jednu glavnu poruku",
  "tips_speech_4_subtitle": "Koristite prirodne rečenice, razgovorne riječi, pauze i jednostavne fraze umjesto da pišete poput formalnog članka.",
  "tips_speech_4_title": "Pišite za govor",
  "tips_speech_5_subtitle": "Konkretne priče i primjeri s kojima se publika može povezati olakšavaju razumijevanje i pamćenje apstraktnih ideja publici.",
  "tips_speech_5_title": "Koristite priče i primjere",
  "tips_speech_6_subtitle": "Završite snažnom mišlju, emocionalnom izjavom, pozivom na akciju ili porukom koju publika može ponijeti sa sobom.",
  "tips_speech_6_title": "Završite nezaboravno",
  "tips_speech_reminder": "Govor bi trebao dobro zvučati naglas. Pročitajte ga naglas i pojednostavite svaku rečenicu koja zvuči neprirodno kada se izgovori.",
  "tips_speech_subtitle": "Izradite govore koji zvuče prirodno kada se izgovore, emocionalno se povežite s publikom i prenesite jasnu poruku.",
  "tips_speech_title": "Savjeti za govor",
  "tips_story_1_subtitle": "Započnite zanimljivim trenutkom, misterijom, sukobom ili pitanjem koje odmah daje čitateljima razlog za nastavak.",
  "tips_story_1_title": "Započnite s jakom udicom",
  "tips_story_2_subtitle": "Dajte likovima jasne ciljeve, motivacije, snage, slabosti i emocionalne razloge iza njihovih odluka.",
  "tips_story_2_title": "Stvorite snažne likove",
  "tips_story_3_subtitle": "Koristite prepreke i teške izbore kako biste izazvali svoje likove i prirodno pokrenuli priču naprijed.",
  "tips_story_3_title": "Stvorite značajne sukobe",
  "tips_story_4_subtitle": "Koristite radnje, dijalog, reakcije i senzorne detalje kako bi čitatelji mogli prirodno doživjeti važne trenutke.",
  "tips_story_4_title": "Pokažite, nemojte samo pričati",
  "tips_story_5_subtitle": "Uravnotežite uzbudljive scene s mirnijim emocionalnim trenucima kako se priča nikada ne bi činila prebrzom ili nepotrebno sporom.",
  "tips_story_5_title": "Kontrolirajte tempo",
  "tips_story_6_subtitle": "Smisleno riješite središnji sukob i ostavite čitateljima nezaboravnu završnu emociju, ideju ili spoznaju.",
  "tips_story_6_title": "Završite s utjecajem",
  "tips_story_reminder": "Svaka scena treba imati svrhu. Neka otkrije lik, produbi emocije, stvori sukob ili pomakne priču naprijed.",
  "tips_story_subtitle": "Stvorite zanimljive priče s pamtljivim likovima, značajnim sukobima, prirodnim tempom i zadovoljavajućim napredovanjem.",
  "tips_story_title": "Savjeti za priču",
